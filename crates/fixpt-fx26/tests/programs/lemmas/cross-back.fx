; Rejected: the lemma goes one way only.
(define-generative (tree (a type)) (oneof (leaf a) (node (tupof (l (tree a)) (r (tree a))))))
(define-generative (tree2 (a type)) (oneof (leaf a) (node (tupof (l (tree2 a)) (r (tree2 a))))))
(define* t2 (proves (poly ((a type)) (<= (tree a) (tree2 a))))
  (lambda (t)
    (up-tree2 (tagcase (down-tree t)
                (leaf x (one leaf x))
                (node (l r) (one node (tup (l (t2 l)) (r (t2 r)))))))))
(define one (tree2 int) (up-tree2 (one leaf 1)))
(define two (tree int) one)
