;;; A non-regular lemma: its proof passes itself a coercion for pairs, a
;;; lambda whose parameter says its type.
(define-type (pair (a type)) (tupof (l a) (r a)))
(define-generative (nest (a type))
  (oneof (none unit) (more (tupof (hd a) (tl (nest (pair a)))))))
(define* nest-up (proves (poly ((a type) (b type)) (<= (nest a) (nest b)) (<= a b)))
  (lambda (f n)
    (up-nest (tagcase (down-nest n)
               (none u (one none u))
               (more (hd tl) (one more (tup (hd (f hd))
                                                (tl (nest-up (lambda ((p (pair a)))
                                                               (tup (l (f (extract p l)))
                                                                        (r (f (extract p r)))))
                                                             tl)))))))))
(define small (nest (oneof (x int))) (up-nest (one none #u)))
(define wide (nest (oneof (x int) (y bool))) small)
