;;; Generated by `fixpt_native::cellular::x64::fx26_regs_module` from the
;;; x86_64 machine's register code; `FIXPT_BLESS=1 cargo test -p fixpt-fx26
;;; --test layout` rewrites it. A module file, which the conductor loads (`TODO.md` §68).

(define r-result int 0)  ; a register
(define r-rdi int 7)  ; a register
(define r-rsi int 6)  ; a register
(define r-r8 int 8)  ; a register
(define r-rcx int 1)  ; a register
(define r-rdx int 2)  ; a register
(define r-t int 14)  ; a register
(define r-sp int 4)  ; a register
(define r-st-regs int 760)  ; a State field's offset
(define r-st-leaf-link int 744)  ; a State field's offset
(define r-st-pure int 752)  ; a State field's offset
(define r-st-top int 176)  ; a State field's offset
(define r-st-alloc-limit int 184)  ; a State field's offset
(define r-st-words int 192)  ; a State field's offset
(define r-st-regions int 200)  ; a State field's offset
(define r-null int 19)  ; a Value's bits
(define r-unspecified int 43)  ; a Value's bits
(define r-char0 int 67)  ; a Value's bits
(define r-f32-0 int 75)  ; a Value's bits
(define r-tag-header int 6)  ; a tag
(define r-kind-extension int 255)  ; a header's kind when F is in an extension word
(define r-region-slots int 256)  ; regions with a slot in the heap's table
(define r-regs int 8)  ; registers of register code
(define r-trap-prim int 10)  ; a trap's code

;; How many operand cells follow register-code instruction `n`.
(define r-operands (subr pure (int) int)
  (lambda (n)
    (case n
      ((0) 1)  ; args
      ((1) 1)  ; const
      ((2) 1)  ; global
      ((3) 1)  ; setglbl
      ((4) 1)  ; reg
      ((5) 1)  ; setreg
      ((6) 2)  ; movereg
      ((7) 1)  ; lexical
      ((8) 1)  ; save
      ((9) 1)  ; pop
      ((10) 1)  ; stack
      ((11) 1)  ; setstk
      ((12) 2)  ; load
      ((13) 2)  ; store
      ((14) 1)  ; op1
      ((15) 2)  ; op2
      ((16) 2)  ; op2imm
      ((17) 1)  ; field
      ((18) 2)  ; setfield
      ((19) 2)  ; prim
      ((20) 2)  ; lambda
      ((21) 1)  ; invoke
      ((22) 1)  ; tailinvoke
      ((24) 1)  ; branch
      ((25) 1)  ; branchf
      ((26) 2)  ; cellular
      ((27) 1)  ; invokeself
      ((28) 3)  ; global-guard
      ((29) 1)  ; brancht
      ((31) 1)  ; prim1
      ((32) 2)  ; prim2
      ((33) 2)  ; prim2imm
      ((34) 3)  ; prim3imm
      (else 0))))

;; The name of runtime primitive `p`, if register code names it; else "".
(define r-prim-name (subr pure (int) string)
  (lambda (p)
    (case p
      ((4) "pair?")
      ((5) "null?")
      ((6) "boolean?")
      ((7) "symbol?")
      ((8) "string?")
      ((9) "char?")
      ((21) "exact-integer?")
      ((34) "modulo")
      ((65) "char-numeric?")
      ((66) "char-whitespace?")
      ((69) "string-length")
      ((70) "string-ref")
      ((78) "string=?")
      ((132) "%make-bloblet")
      ((134) "%fx26-char-in?")
      ((242) "%fx26-bitwise-and")
      ((243) "%fx26-bitwise-ior")
      ((244) "%fx26-bitwise-xor")
      ((245) "%fx26-bitwise-not")
      ((246) "%fx26-arithmetic-shift")
      ((300) "%fx26-add")
      ((301) "%fx26-sub")
      ((302) "%fx26-mul")
      ((303) "%fx26-quotient")
      ((304) "%fx26-int-less")
      ((305) "%fx26-int-eq")
      ((326) "%fx26-fixnum?")
      ((329) "%fx26-procedure?")
      ((330) "%fx26-array?")
      ((331) "%fx26-f32?")
      ((332) "%fx26-box?")
      ((333) "%fx26-sum?")
      ((334) "%fx26-product?")
      ((362) "%make-frozen")
      ((375) "%bloblet-fields")
      ((378) "%bloblet-set!")
      ((403) "%make-box")
      ((426) "%region-cons")
      ((427) "%region-new")
      ((429) "%region-make-icell")
      ((430) "%region-closure")
      ((432) "%symbol-hash")
      (else ""))))

;; The number of the runtime primitive register code names `name`.
(define r-prim-number (subr pure (string) int)
  (lambda (name)
    (case name
      (("string-length") 69)
      (("string-ref") 70)
      (("%region-cons") 426)
      (("%bloblet-fields") 375)
      (("%bloblet-set!") 378)
      (("char-whitespace?") 66)
      (("char-numeric?") 65)
      (("%symbol-hash") 432)
      (("%fx26-fixnum?") 326)
      (("char?") 9)
      (("boolean?") 6)
      (("symbol?") 7)
      (("string?") 8)
      (("pair?") 4)
      (("null?") 5)
      (("%fx26-bitwise-and") 242)
      (("%fx26-bitwise-ior") 243)
      (("%fx26-bitwise-xor") 244)
      (("%fx26-bitwise-not") 245)
      (("exact-integer?") 21)
      (("%fx26-array?") 330)
      (("%fx26-f32?") 331)
      (("%fx26-box?") 332)
      (("%fx26-sum?") 333)
      (("%fx26-product?") 334)
      (("%fx26-procedure?") 329)
      (("%fx26-char-in?") 134)
      (("string=?") 78)
      (("modulo") 34)
      (("%make-box") 403)
      (("%region-new") 427)
      (("%region-make-icell") 429)
      (("%region-closure") 430)
      (("%make-frozen") 362)
      (("%make-bloblet") 132)
      (("%fx26-quotient") 303)
      (("%fx26-mul") 302)
      (("%fx26-arithmetic-shift") 246)
      (("%fx26-add") 300)
      (("%fx26-sub") 301)
      (("%fx26-int-less") 304)
      (("%fx26-int-eq") 305)
      (else -1))))

