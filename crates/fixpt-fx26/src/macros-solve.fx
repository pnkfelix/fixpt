;;; Typed hygienic macros, in FX-26: what a signature inferred says of the
;;; scopes, from where the templates place each part (`infer.rs`'s
;;; `solve`), how it is written (`shown_sty`, `sig_text`), and the
;;; iterations to the signature that says the same twice (`infer`). On top
;;; of `macros-infer.fx`, which it loads and gives on (`infer-module`), so
;;; that `macros.fx` takes one instance of each through it.

(module-parameters ((rs region) (re region) (rm region) (rc region) (rp region)))
(define infer-module ((proj (load-module "fx26:macros-infer.fx") rs re rm rc rp)))
(define files-module (with infer-module files-module))
(define align-module (with files-module align-module))
(define types-module (with align-module types-module))
(define parser-module (with types-module parser-module))
(define reader-types (with parser-module reader-types))
(import reader-types atom lst dotted (type syn))
(import parser-module syn-start syn-end syn-symbol? syn-name syn-symbol len nth mk-list
        mk-symbol syn-datums syn->datum (type syns-a names))
(import types-module fail-at split show-syn kind-of mu-body proper-items
        s-expr s-bvar s-id s-data s-type s-label s-nil s-literal s-pair s-import s-export s-mu
        s-many s-union s-typed s-lambda s-defn s-dvar s-kind bind-rib bind-cage ring-rib ring-at
        bind-direct bind-earlier atm-var atm-rib-of atm-lit
        (type fails addr entries ring rings bind sty stys atm atms))
(import align-module defined lv-rib lv-cage lv-earlier (type macro macro-env levels))
(import infer-module shape-of path-of region leaf? union? boundary-of var-of var-part regions
        via inner int-in? int-assoc found-vars parts-reset! merge roots fingerprint sol-empty
        build built-mus placements-of combine scoped? affine? kind-at pkind-of kd-ty kd-ref
        makes-all absorbed nparts open? sh-seq sh-union sh-leaf
        (type kd kds kinds pkinds ints sol binds-at spans placed placements unsigned
              unsigneds rules items cx mu-parts shape))
(define exports-module (with files-module exports-module))
(import exports-module (type exported))

;;; ------------------------------------------------------------ scopes

;; One level of an environment, its atoms by part; one of a ribcage's, by
;; part; what a region's root must export (`infer.rs`'s `Lv`, `RingD`,
;; `Demand`).
(define-type pents (listof (tupleof int int) acyclic))
(define-datatype lv (iv-rib pents) (iv-cage int))
(define-type lvs (listof lv acyclic))
(define-datatype rd (rd-at int) (rd-rib pents))
(define-type rds (listof rd acyclic))
(define-datatype demand (dm-rib pents) (dm-cage rds))
;; What the regions must export, as said, the last said first.
(define demands (ref (listof (tupleof int demand) acyclic) rs) (new nil))
(define demand! (->* (int demand) unit)
  (lambda (p d) (set demands (cons (tuple p d) (get demands)))))

(define pents=? (->* (pents pents) bool)
  (lambda (a b)
    (if (null? a)
        (null? b)
        (and (not (null? b)) (= (extract (car a) 1) (extract (car b) 1))
             (= (extract (car a) 2) (extract (car b) 2)) (pents=? (cdr a) (cdr b))))))
(define pent-in? (->* ((tupleof int int) pents) bool)
  (lambda (e es)
    (and (not (null? es))
         (or (and (= (extract e 1) (extract (car es) 1)) (= (extract e 2) (extract (car es) 2)))
             (pent-in? e (cdr es))))))
(define rd=? (->* (rd rd) bool)
  (lambda (a b)
    (tagcase a
      (rd-at (x) (tagcase b (rd-at (y) (= x y)) (else z #f)))
      (rd-rib (es) (tagcase b (rd-rib (fs) (pents=? es fs)) (else z #f))))))
;; Entries `es` sorted by part.
(define pents-sorted (->* (pents pents) pents)
  (lambda (es out) (if (null? es) out (pents-sorted (cdr es) (pent-into (car es) out)))))
(define pent-into (->* ((tupleof int int) pents) pents)
  (lambda (e out)
    (cond ((null? out) (list e))
          ((< (extract e 1) (extract (car out) 1)) (cons e out))
          (else (cons (car out) (pent-into e (cdr out)))))))
(define ints-sorted (->* (ints ints) ints)
  (lambda (xs out) (if (null? xs) out (ints-sorted (cdr xs) (int-into (car xs) out)))))
(define int-into (->* (int ints) ints)
  (lambda (x out)
    (cond ((null? out) (list x)) ((< x (car out)) (cons x out))
          (else (cons (car out) (int-into x (cdr out)))))))

;; Environment `env` of clause `cid`, its atoms by part, in a list of one;
;; none if it has a level an inferred signature does not say.
(define lvs-of (->* (int levels) (listof lvs acyclic))
  (lambda (cid env)
    (if (null? env)
        (list (the lvs nil))
        (let ((rest (lvs-of cid (cdr env))))
          (if (null? rest)
              nil
              (tagcase (car env)
                (lv-rib (as)
                  (let ((es (rib-pents cid as nil)))
                    (if (null? es)
                        nil
                        (list (cons (iv-rib (pents-sorted (car es) nil)) (car rest))))))
                (lv-cage (n)
                  (let ((p (var-part cid n)))
                    (if (null? p) nil (list (cons (iv-cage (car p)) (car rest))))))
                (lv-earlier (as) nil)))))))
(define rib-pents (->* (int atms pents) (listof pents acyclic))
  (lambda (cid as es)
    (if (null? as)
        (list es)
        (let ((nd (tagcase (car as)
                    (atm-var (n d) (list (tuple n (if d 4 1))))
                    (atm-rib-of (n) (list (tuple n 2)))
                    (atm-lit (t d) (the (listof (tupleof symbol int) acyclic) nil)))))
          (if (null? nd)
              (rib-pents cid (cdr as) es)
              (let ((p (var-part cid (extract (car nd) 1))) (d (extract (car nd) 2)))
                (if (null? p)
                    nil
                    (rib-pents cid (cdr as) (pent-merged (car p) d es)))))))))
(define pent-merged (->* (int int pents) pents)
  (lambda (p d es)
    (cond ((null? es) (list (tuple p d)))
          ((= p (extract (car es) 1))
           (let ((e (extract (car es) 2)))
             (if (and (or (= e 1) (= e 4)) (not (= e d))) (cons (tuple p 5) (cdr es)) es)))
          (else (cons (car es) (pent-merged p d (cdr es)))))))
(define atoms-of (->* (lv) ints)
  (lambda (l)
    (tagcase l
      (iv-rib (es) (pent-parts es))
      (iv-cage (p) (list p)))))
(define pent-parts (->* (pents) ints)
  (lambda (es) (if (null? es) nil (cons (extract (car es) 1) (pent-parts (cdr es))))))

;; Where each of levels `ls` (innermost first) of part `p` is said: on `p`
;; while each level's binders are in or under its region; then on the part
;; whose region that is, and so on out. Each site with its region and
;; levels, in a list of one.
(define-type site (tupleof int int lvs))
(define-type sites (listof site acyclic))
(define sites-of (->* (int lvs) (listof sites acyclic))
  (lambda (p ls) (sites-from p (regions p) 0 ls nil)))
(define sites-from (->* (int ints int lvs sites) (listof sites acyclic))
  (lambda (p rs i ls out)
    (if (null? ls)
        (list (reverse out))
        (let ((j (first-around rs i (atoms-of (car ls)))))
          (if (< j 0)
              nil
              (let* ((site (if (= j 0) p (car (boundary-of (nth-int rs (- j 1))))))
                     (out2 (if (and (not (null? out)) (= site (extract (car out) 1)))
                               (cons (tuple site (extract (car out) 2)
                                            (append (extract (car out) 3)
                                                    (the lvs (list (car ls)))))
                                     (cdr out))
                               (cons (tuple site (nth-int rs j) (the lvs (list (car ls)))) out))))
                (sites-from p rs j (cdr ls) out2)))))))
(define nth-int (->* (ints int) int)
  (lambda (xs i) (if (= i 0) (car xs) (nth-int (cdr xs) (- i 1)))))
;; The first of regions `rs` from `i` around each of `xs`; -1 if none is.
(define first-around (->* (ints int ints) int)
  (lambda (rs i xs)
    (cond ((>= i (len-ints rs)) -1)
          ((all-via? xs (nth-int rs i)) i)
          (else (first-around rs (+ i 1) xs)))))
(define len-ints (->* (ints) int) (lambda (xs) (if (null? xs) 0 (+ 1 (len-ints (cdr xs))))))
(define all-via? (->* (ints int) bool)
  (lambda (xs r) (or (null? xs) (and (not (null? (via (car xs) r))) (all-via? (cdr xs) r)))))

;; Levels `ls`, said from region `r` for clause `cid` (`infer.rs`'s
;; `rings`), in a list of one; what each region exports noted.
(define rings-of (->* (lvs int int) (listof rds acyclic))
  (lambda (ls r cid)
    (if (null? ls)
        (list (the rds nil))
        (let ((u (through (car ls) r)))
          (if (>= u 0)
              (let* ((run (run-through ls r u)) (m (inner u cid)))
                (if (null? m)
                    nil
                    (let ((sub (rings-of (extract run 1) (car m) cid)))
                      (if (null? sub)
                          nil
                          (begin
                            (demand! (car m) (dm-cage (car sub)))
                            (let ((rest (rings-of (extract run 2) r cid)))
                              (if (null? rest) nil (list (cons (rd-at u) (car rest))))))))))
              (let ((one (tagcase (car ls)
                           (iv-cage (y)
                             (let ((v (via y r)))
                               (if (and (not (null? v)) (< (car v) 0))
                                   (the (listof rd acyclic) (list (rd-at y)))
                                   nil)))
                           (iv-rib (es)
                             (let ((e (rib-entries es r cid)))
                               (if (null? e) nil (list (rd-rib (car e)))))))))
                (if (null? one)
                    nil
                    (let ((rest (rings-of (cdr ls) r cid)))
                      (if (null? rest) nil (list (cons (car one) (car rest))))))))))))
;; The `union` in `r` all of level `l`'s binders are inside; -1 if none.
(define through (->* (lv int) int)
  (lambda (l r)
    (let ((xs (atoms-of l)))
      (if (null? xs)
          -1
          (let ((v (via (car xs) r)))
            (if (and (not (null? v)) (>= (car v) 0) (union? (car v)) (all-through? xs r (car v)))
                (car v)
                -1))))))
(define all-through? (->* (ints int int) bool)
  (lambda (xs r u)
    (or (null? xs)
        (let ((v (via (car xs) r)))
          (and (not (null? v)) (= (car v) u) (all-through? (cdr xs) r u))))))
;; The levels from the first of `ls` all through `u`, and the rest.
(define run-through (->* (lvs int int) (tupleof lvs lvs))
  (lambda (ls r u)
    (if (and (not (null? ls)) (= (through (car ls) r) u))
        (let ((more (run-through (cdr ls) r u)))
          (tuple (cons (car ls) (extract more 1)) (extract more 2)))
        (tuple (the lvs nil) ls))))
(define rib-entries (->* (pents int int) (listof pents acyclic))
  (lambda (es r cid)
    (let ((split (entries-by es r nil nil)))
      (if (null? split)
          nil
          (let ((rest (through-entries (extract (car split) 2) r cid)))
            (if (null? rest)
                nil
                (list (pents-sorted (append (extract (car split) 1) (car rest)) nil))))))))
;; Entries `es` in `r`, and those through each part in `r`, by part, in
;; the order first found; none if one is not under `r`.
(define-type thru (listof (tupleof int pents) acyclic))
(define entries-by (->* (pents int pents thru) (listof (tupleof pents thru) acyclic))
  (lambda (es r out th)
    (if (null? es)
        (list (tuple out th))
        (let ((v (via (extract (car es) 1) r)))
          (cond ((null? v) nil)
                ((< (car v) 0) (entries-by (cdr es) r (append out (the pents (list (car es)))) th))
                (else (entries-by (cdr es) r out (thru-add (car v) (car es) th))))))))
(define thru-add (->* (int (tupleof int int) thru) thru)
  (lambda (b e th)
    (cond ((null? th) (list (tuple b (the pents (list e)))))
          ((= b (extract (car th) 1))
           (cons (tuple b (append (extract (car th) 2) (the pents (list e)))) (cdr th)))
          (else (cons (car th) (thru-add b e (cdr th)))))))
(define through-entries (->* (thru int int) (listof pents acyclic))
  (lambda (th r cid)
    (if (null? th)
        (list (the pents nil))
        (let* ((b (extract (car th) 1)) (m (inner b cid)))
          (if (null? m)
              nil
              (let ((sub (rib-entries (extract (car th) 2) (car m) cid)))
                (if (null? sub)
                    nil
                    (begin
                      (demand! (car m) (dm-rib (car sub)))
                      (let ((rest (through-entries (cdr th) r cid)))
                        (if (null? rest) nil (list (cons (tuple b 2) (car rest)))))))))))))

;; One site's rings, of each clause's (`infer.rs`'s `merge_rings`).
(define-type site-rings (listof (tupleof int rds) acyclic))
(define merge-rings (->* (site-rings) rds)
  (lambda (list)
    (if (null? list)
        nil
        (let ((longest (longest-rings (cdr list) (extract (car list) 2))))
          (begin (fit-each list longest) longest)))))
(define len-rds (->* (rds) int) (lambda (xs) (if (null? xs) 0 (+ 1 (len-rds (cdr xs))))))
(define longest-rings (->* (site-rings rds) rds)
  (lambda (xs best)
    (cond ((null? xs) best)
          ((>= (len-rds (extract (car xs) 2)) (len-rds best))
           (longest-rings (cdr xs) (extract (car xs) 2)))
          (else (longest-rings (cdr xs) best)))))
(define fit-each (->* (site-rings rds) unit)
  (lambda (xs longest)
    (if (null? xs)
        #u
        (begin (fit (extract (car xs) 1) (extract (car xs) 2) longest)
               (fit-each (cdr xs) longest)))))
(define fit (->* (int rds rds) unit)
  (lambda (cid rs ls)
    (if (null? ls)
        #u
        (let ((l (car ls)))
          (cond
            ((and (not (null? rs)) (rd=? (car rs) l)) (fit cid (cdr rs) (cdr ls)))
            ((and (not (null? rs))
                  (tagcase (car rs)
                    (rd-rib (a) (tagcase l (rd-rib (b) (rib-fits? a b)) (else y #f)))
                    (else y #f)))
             (begin
               (tagcase (car rs)
                 (rd-rib (a) (tagcase l (rd-rib (b) (empty-ribs! cid a b)) (else y #u)))
                 (else y #u))
               (fit cid (cdr rs) (cdr ls))))
            ((tagcase l (rd-at (u) (union? u)) (else y #f))
             (begin
               (tagcase l
                 (rd-at (u) (let ((m (inner u cid)))
                              (if (null? m) #u (demand! (car m) (dm-cage nil)))))
                 (else y #u))
               (fit cid rs (cdr ls))))
            (else (fit cid rs (cdr ls))))))))
(define rib-fits? (->* (pents pents) bool)
  (lambda (a b) (and (all-in? a b) (all-in-or-union? b a))))
(define all-in? (->* (pents pents) bool)
  (lambda (a b) (or (null? a) (and (pent-in? (car a) b) (all-in? (cdr a) b)))))
(define all-in-or-union? (->* (pents pents) bool)
  (lambda (b a)
    (or (null? b)
        (and (or (pent-in? (car b) a) (and (= (extract (car b) 2) 2) (union? (extract (car b) 1))))
             (all-in-or-union? (cdr b) a)))))
(define empty-ribs! (->* (int pents pents) unit)
  (lambda (cid a b)
    (if (null? b)
        #u
        (begin
          (if (pent-in? (car b) a)
              #u
              (let ((m (inner (extract (car b) 1) cid)))
                (if (null? m) #u (demand! (car m) (dm-rib nil)))))
          (empty-ribs! cid a (cdr b))))))

(define ring-of (->* (rd) ring)
  (lambda (r)
    (tagcase r
      (rd-at (x) (ring-at (path-of x)))
      (rd-rib (es) (ring-rib (entries-of es))))))
(define entries-of (->* (pents) entries)
  (lambda (es)
    (if (null? es) nil (cons (tuple (path-of (extract (car es) 1)) (extract (car es) 2))
                             (entries-of (cdr es))))))
(define rings-bind (->* (rds) bind)
  (lambda (rs)
    (if (and (not (null? rs)) (null? (cdr rs)) (tagcase (car rs) (rd-rib (es) #t) (else y #f)))
        (tagcase (car rs) (rd-rib (es) (bind-rib (entries-of es))) (else y (bind-rib nil)))
        (bind-cage (rings-each rs)))))
(define rings-each (->* (rds) rings)
  (lambda (rs) (if (null? rs) nil (cons (ring-of (car rs)) (rings-each (cdr rs))))))

;;; ------------------------------------------------------------ solving

;; What the templates' placements, `ps` (by clause, none where a template
;; is refused), say of each part, from `prev`; `made`, each clause's
;; template's definitions; `makes`, each macro's; `of`, each clause's macro.
(define-type by-clause (listof (listof placed acyclic) acyclic))
(define solve (->* (by-clause sol ints ints) sol)
  (lambda (ps prev makes of)
    (let* ((pk (keep-failed ps (extract prev 2) (pkinds-each ps 0 nil)))
           (ks (part-kinds (get found-vars) pk nil))
           (kinds (extract ks 1)) (sticky (extract ks 2))
           (many (many-each ps 0 kinds nil)))
      (begin
        (set demands nil)
        (let* ((sites (sites-each ps 0 kinds nil))
               (imports (imports-each (sorted-sites sites nil)))
               (roots-ex (root-exports (get roots) 0 makes of ps))
               (exports (exports-of-demands)))
          (tuple kinds pk many imports exports roots-ex sticky))))))

;; A part of the signature so far: a list by ellipsis or a `union`,
;; itself; one whose syntax type is not known yet, none.
(define classify (->* (sty) kds)
  (lambda (core)
    (tagcase core
      (s-mu (id)
        (let ((p (part-of-mu id (get built-mus))))
          (cond ((null? p) (list (kd-ty core)))
                ((leaf? (car p)) nil)
                (else (list (kd-ref (car p)))))))
      (else y (list (kd-ty core))))))
(define part-of-mu (->* (int mu-parts) ints)
  (lambda (id xs)
    (cond ((null? xs) nil)
          ((= id (extract (car xs) 2)) (list (extract (car xs) 1)))
          (else (part-of-mu id (cdr xs))))))
(define pkinds-each (->* (by-clause int pkinds) pkinds)
  (lambda (ps cid out)
    (if (null? ps)
        out
        (pkinds-each (cdr ps) (+ cid 1)
                     (if (null? (car ps))
                         out
                         (pkinds-of cid (by-name (extract (car (car ps)) 1) nil) out))))))
(define-type named-kds (listof (tupleof symbol kds) acyclic))
(define by-name (->* (placements named-kds) named-kds)
  (lambda (pls out)
    (if (null? pls)
        out
        (by-name (cdr pls) (name-add (extract (car pls) 1) (classify (extract (car pls) 2)) out)))))
(define name-add (->* (symbol kds named-kds) named-kds)
  (lambda (n ks out)
    (cond ((null? out) (list (tuple n ks)))
          ((symbol=? n (extract (car out) 1))
           (cons (tuple n (append (extract (car out) 2) ks)) (cdr out)))
          (else (cons (car out) (name-add n ks (cdr out)))))))
(define pkinds-of (->* (int named-kds pkinds) pkinds)
  (lambda (cid xs out)
    (if (null? xs)
        out
        (let ((c (extract (combine (extract (car xs) 2)) 1)))
          (pkinds-of cid (cdr xs)
                     (if (null? c) out (cons (tuple cid (extract (car xs) 1) (car c)) out)))))))
;; Kept from before where a clause's template is not aligned, yet.
(define keep-failed (->* (by-clause pkinds pkinds) pkinds)
  (lambda (ps prev out)
    (cond ((null? prev) out)
          ((and (null? (nth-placed ps (extract (car prev) 1)))
                (null? (pkind-of (extract (car prev) 1) (extract (car prev) 2) out))
                (tagcase (extract (car prev) 3) (kd-ty (t) #t) (else y #f)))
           (keep-failed ps (cdr prev) (cons (car prev) out)))
          (else (keep-failed ps (cdr prev) out)))))
(define nth-placed (->* (by-clause int) (listof placed acyclic))
  (lambda (ps i) (if (= i 0) (car ps) (nth-placed (cdr ps) (- i 1)))))
;; Each leaf's syntax type, of its pattern variables'; and the lists by
;; ellipsis whose element turns out to be of more than one.
(define part-kinds (->* ((listof (tupleof int symbol int int) acyclic) pkinds ints)
                        (tupleof kinds spans))
  (lambda (vs pk seen)
    (cond
      ((null? vs) (tuple (the kinds nil) (the spans nil)))
      ((or (int-in? (extract (car vs) 3) seen) (not (leaf? (extract (car vs) 3))))
       (part-kinds (cdr vs) pk seen))
      (else
       (let* ((p (extract (car vs) 3))
              (c (combine (kinds-of-part p (get found-vars) pk)))
              (rest (part-kinds (cdr vs) pk (cons p seen)))
              (b (boundary-of p))
              (span (if (null? b) nil (absorbed-span (car b) (get absorbed)))))
         (tuple (if (null? (extract c 1))
                    (extract rest 1)
                    (cons (tuple p (car (extract c 1))) (extract rest 1)))
                (if (and (extract c 2) (not (null? span)))
                    (cons (car span) (extract rest 2))
                    (extract rest 2))))))))
(define kinds-of-part (->* (int (listof (tupleof int symbol int int) acyclic) pkinds) kds)
  (lambda (p vs pk)
    (cond ((null? vs) nil)
          ((= p (extract (car vs) 3))
           (append (pkind-of (extract (car vs) 1) (extract (car vs) 2) pk)
                   (kinds-of-part p (cdr vs) pk)))
          (else (kinds-of-part p (cdr vs) pk)))))
(define absorbed-span (->* (int (listof (tupleof int int int) acyclic)) spans)
  (lambda (s xs)
    (cond ((null? xs) nil)
          ((= s (extract (car xs) 1)) (list (tuple (extract (car xs) 2) (extract (car xs) 3))))
          (else (absorbed-span s (cdr xs))))))
(define kind-of-part (->* (int kinds) kds)
  (lambda (p ks) (if (leaf? p) (kind-at p ks) (list (kd-ref p)))))

;; `many`: placed more than once, in a part another macro's signature says
;; is, or under more ellipses than the pattern has it.
(define many-each (->* (by-clause int kinds ints) ints)
  (lambda (ps cid ks out)
    (if (null? ps)
        out
        (many-each (cdr ps) (+ cid 1) ks
                   (if (null? (car ps))
                       out
                       (let ((pls (extract (car (car ps)) 1))) (many-in cid pls pls ks out)))))))
(define many-in (->* (int placements placements kinds ints) ints)
  (lambda (cid pls all ks out)
    (if (null? pls)
        out
        (let* ((n (extract (car pls) 1)) (v (var-of cid n))
               (k (if (null? v) nil (kind-of-part (extract (car v) 1) ks)))
               (more (and (not (null? k)) (affine? (car k))
                          (or (> (count-named n all) 1) (extract (car pls) 4)
                              (> (extract (car pls) 5) (extract (car v) 2))))))
          (many-in cid (cdr pls) all ks
                   (if (and more (not (int-in? (extract (car v) 1) out)))
                       (cons (extract (car v) 1) out)
                       out))))))
(define count-named (->* (symbol placements) int)
  (lambda (n pls)
    (cond ((null? pls) 0)
          ((symbol=? n (extract (car pls) 1)) (+ 1 (count-named n (cdr pls))))
          (else (count-named n (cdr pls))))))

;; The scopes: each site's rings, of each clause's, in the order said.
(define-type site-list (listof (tupleof int site-rings) acyclic))
(define site-add (->* (int int rds site-list) site-list)
  (lambda (s cid rs xs)
    (cond ((null? xs) (list (tuple s (the site-rings (list (tuple cid rs))))))
          ((= s (extract (car xs) 1))
           (cons (tuple s (append (extract (car xs) 2) (the site-rings (list (tuple cid rs)))))
                 (cdr xs)))
          (else (cons (car xs) (site-add s cid rs (cdr xs)))))))
(define sites-each (->* (by-clause int kinds site-list) site-list)
  (lambda (ps cid ks out)
    (if (null? ps)
        out
        (sites-each (cdr ps) (+ cid 1) ks
                    (if (null? (car ps))
                        out
                        (sites-in cid (extract (car (car ps)) 1) nil ks out))))))
(define sites-in (->* (int placements names kinds site-list) site-list)
  (lambda (cid pls seen ks out)
    (if (null? pls)
        out
        (let* ((n (extract (car pls) 1)) (p (var-part cid n))
               (k (if (null? p) nil (kind-of-part (car p) ks))))
          (if (or (null? p) (name-seen? n seen) (null? k) (not (scoped? (car k))))
              (sites-in cid (cdr pls) (if (null? p) seen (cons n seen)) ks out)
              (sites-in cid (cdr pls) (cons n seen) ks
                        (sites-of-env cid (car p) (extract (car pls) 3) out)))))))
(define name-seen? (->* (symbol names) bool)
  (lambda (n ns) (and (not (null? ns)) (or (symbol=? n (car ns)) (name-seen? n (cdr ns))))))
(define sites-of-env (->* (int int levels site-list) site-list)
  (lambda (cid p env out)
    (let ((ls (lvs-of cid env)))
      (if (null? ls)
          out
          (let ((at (sites-of p (car ls))))
            (if (null? at)
                out
                (let ((out2 (if (or (null? (car at)) (not (= (extract (car (car at)) 1) p)))
                                (site-add p cid nil out)
                                out)))
                  (site-rings-each cid (car at) out2))))))))
(define site-rings-each (->* (int (listof site acyclic) site-list) site-list)
  (lambda (cid at out)
    (if (null? at)
        out
        (let ((rs (rings-of (extract (car at) 3) (extract (car at) 2) cid)))
          (site-rings-each cid (cdr at)
                           (if (null? rs) out (site-add (extract (car at) 1) cid (car rs) out)))))))
(define sorted-sites (->* (site-list site-list) site-list)
  (lambda (xs out) (if (null? xs) out (sorted-sites (cdr xs) (site-into (car xs) out)))))
(define site-into (->* ((tupleof int site-rings) site-list) site-list)
  (lambda (x out)
    (cond ((null? out) (list x))
          ((< (extract x 1) (extract (car out) 1)) (cons x out))
          (else (cons (car out) (site-into x (cdr out)))))))
(define imports-each (->* (site-list) binds-at)
  (lambda (xs)
    (if (null? xs)
        nil
        (let* ((rs (merge-rings (extract (car xs) 2))) (rest (imports-each (cdr xs))))
          (if (null? rs) rest (cons (tuple (extract (car xs) 1) (rings-bind rs)) rest))))))

;; What a macro that makes definitions defines of what a use gives.
(define root-exports (->* (ints int ints ints by-clause) binds-at)
  (lambda (rs mi makes of ps)
    (if (null? rs)
        nil
        (let* ((rest-now (if (= (nth-int makes mi) 1)
                             (let ((rings (merge-rings (root-rings (car rs) mi of ps 0))))
                               (if (null? rings) nil (list (tuple mi (rings-bind rings)))))
                             nil)))
          (append rest-now (root-exports (cdr rs) (+ mi 1) makes of ps))))))
(define root-rings (->* (int int ints by-clause int) site-rings)
  (lambda (root mi of ps cid)
    (cond
      ((null? ps) nil)
      ((or (null? (car ps)) (not (= (car of) mi)) (null? (extract (car (car ps)) 2)))
       (root-rings root mi (cdr of) (cdr ps) (+ cid 1)))
      (else
       (let* ((e (car (extract (car (car ps)) 2)))
              (ribs (if (null? (extract e 1))
                        nil
                        (let ((l (lvs-of cid (the levels (list (lv-rib (extract e 1)))))))
                          (if (and (not (null? l)) (not (null? (car l))))
                              (list (car (car l)))
                              nil))))
              (cages (cage-lvs (ints-sorted (cage-parts cid (extract e 2)) nil)))
              (rs (rings-of (append ribs cages) root cid))
              (rest (root-rings root mi (cdr of) (cdr ps) (+ cid 1))))
         (if (null? rs) rest (cons (tuple cid (car rs)) rest)))))))
(define cage-parts (->* (int names) ints)
  (lambda (cid ns)
    (if (null? ns)
        nil
        (let ((p (var-part cid (car ns))))
          (append p (cage-parts cid (cdr ns)))))))
(define cage-lvs (->* (ints) lvs)
  (lambda (ps) (if (null? ps) nil (cons (iv-cage (car ps)) (cage-lvs (cdr ps))))))

;; Each region's export, the first said (an empty one only where none is);
;; each other member of a `union` one that exports, an empty one.
(define-type got-demands (listof (tupleof int demand) acyclic))
(define exports-of-demands (->* () binds-at)
  (lambda ()
    (let ((got (unions-filled 0 (consolidated (reverse (get demands)) nil))))
      (demand-binds got))))
(define empty-demand? (->* (demand) bool)
  (lambda (d) (tagcase d (dm-rib (es) (null? es)) (dm-cage (rs) (null? rs)))))
(define demand-at (->* (int got-demands) (listof demand acyclic))
  (lambda (p xs)
    (cond ((null? xs) nil)
          ((= p (extract (car xs) 1)) (list (extract (car xs) 2)))
          (else (demand-at p (cdr xs))))))
(define demand-set (->* (int demand got-demands) got-demands)
  (lambda (p d xs)
    (cond ((null? xs) (list (tuple p d)))
          ((= p (extract (car xs) 1)) (cons (tuple p d) (cdr xs)))
          (else (cons (car xs) (demand-set p d (cdr xs)))))))
(define consolidated (->* (got-demands got-demands) got-demands)
  (lambda (ds got)
    (if (null? ds)
        got
        (let* ((p (extract (car ds) 1)) (d (extract (car ds) 2)) (old (demand-at p got)))
          (consolidated (cdr ds)
                        (if (or (null? old) (and (empty-demand? (car old)) (not (empty-demand? d))))
                            (demand-set p d got)
                            got))))))
(define unions-filled (->* (int got-demands) got-demands)
  (lambda (p got)
    (if (= p (get nparts))
        got
        (unions-filled (+ p 1)
                       (tagcase (shape-of p)
                         (sh-union (ms)
                           (let ((d (first-demand ms got)))
                             (if (null? d) got (fill-members ms (car d) got))))
                         (else y got))))))
(define first-demand (->* (ints got-demands) (listof demand acyclic))
  (lambda (ms got)
    (cond ((null? ms) nil)
          ((not (null? (demand-at (car ms) got))) (demand-at (car ms) got))
          (else (first-demand (cdr ms) got)))))
(define fill-members (->* (ints demand got-demands) got-demands)
  (lambda (ms d got)
    (cond ((null? ms) got)
          ((not (null? (demand-at (car ms) got))) (fill-members (cdr ms) d got))
          (else (fill-members (cdr ms) d
                              (demand-set (car ms)
                                          (tagcase d (dm-rib (es) (dm-rib nil))
                                                   (dm-cage (rs) (dm-cage nil)))
                                          got))))))
(define demand-binds (->* (got-demands) binds-at)
  (lambda (xs)
    (if (null? xs)
        nil
        (cons (tuple (extract (car xs) 1)
                     (tagcase (extract (car xs) 2)
                       (dm-rib (es) (bind-rib (entries-of es)))
                       (dm-cage (rs) (bind-cage (rings-each rs)))))
              (demand-binds (cdr xs))))))

;;; ------------------------------------------------------------ written

;; Syntax type `t` as a signature writes it, at `a`..`b` (`infer.rs`'s
;; `shown_sty`): a `mu` whose variable is used, or whose addresses are
;; from it; a list by ellipsis, `(σ ...)`. `shown`, the `mu`s being
;; written, each with its variable and whether it is used.
(define shown (ref (listof (tupleof int string bool) acyclic) rs) (new nil))
(define show-sty (->* (sty int int) syn)
  (lambda (t a b)
    (let ((sym (lambda ((s string)) (mk-symbol s a b))))
      (tagcase t
        (s-expr () (sym "expr")) (s-lambda () (sym "lambda")) (s-bvar () (sym "bvar"))
        (s-id () (sym "id")) (s-data () (sym "data")) (s-type () (sym "type"))
        (s-label () (sym "label")) (s-dvar () (sym "dvar")) (s-kind () (sym "kind"))
        (s-defn () (sym "defn"))
        (s-nil () (mk-list nil a b))
        (s-literal (n) (mk-list (list (sym "literal") (atom n a b 0)) a b))
        (s-pair (x y) (show-pair t nil a b))
        (s-import (x bd) (mk-list (list (sym "import") (show-sty x a b) (show-bind bd a b)) a b))
        (s-export (x bd) (mk-list (list (sym "export") (show-sty x a b) (show-bind bd a b)) a b))
        (s-many (x) (mk-list (list (sym "many") (show-sty x a b)) a b))
        (s-typed (x h) (show-sty x a b))
        (s-union (ms) (mk-list (cons (sym "union") (show-each ms a b)) a b))
        (s-mu (id) (show-mu id a b))))))
(define show-each (->* (stys int int) syns-a)
  (lambda (ms a b) (if (null? ms) nil (cons (show-sty (car ms) a b) (show-each (cdr ms) a b)))))
(define show-pair (->* (sty syns-a int int) syn)
  (lambda (cur items a b)
    (tagcase cur
      (s-pair (x y) (show-pair y (append items (the syns-a (list (show-sty x a b)))) a b))
      (s-nil () (mk-list items a b))
      (s-mu (id)
        (let ((e (if (null? (shown-of id (get shown))) (listed-elem id) nil)))
          (if (null? e)
              (joined-list items (show-sty cur a b) a b)
              (mk-list (append items
                               (the syns-a (list (show-sty (car e) a b) (mk-symbol "..." a b))))
                       a b))))
      (else y (joined-list items (show-sty cur a b) a b)))))
;; Items `xs` and tail `t` as one list: a tail that is a list joined to it.
(define joined-list (->* (syns-a syn int int) syn)
  (lambda (xs t a b)
    (tagcase t
      (lst (more d c e y) (mk-list (append xs more) a b))
      (dotted (more tl d c e y)
        (dotted (append xs more) tl (datum-dotted (syn-datums (append xs more)) (syn->datum tl))
                a b 0))
      (else y
        (if (null? xs) t (dotted xs t (datum-dotted (syn-datums xs) (syn->datum t)) a b 0))))))
(define shown-of (->* (int (listof (tupleof int string bool) acyclic)) (listof string acyclic))
  (lambda (id xs)
    (cond ((null? xs) nil)
          ((= id (extract (car xs) 1)) (list (extract (car xs) 2)))
          (else (shown-of id (cdr xs))))))
(define used! (->* (int (listof (tupleof int string bool) acyclic))
                   (listof (tupleof int string bool) acyclic))
  (lambda (id xs)
    (cond ((null? xs) nil)
          ((= id (extract (car xs) 1)) (cons (tuple id (extract (car xs) 2) #t) (cdr xs)))
          (else (cons (car xs) (used! id (cdr xs)))))))
(define len-shown (->* ((listof (tupleof int string bool) acyclic)) int)
  (lambda (xs) (if (null? xs) 0 (+ 1 (len-shown (cdr xs))))))
(define show-mu (->* (int int int) syn)
  (lambda (id a b)
    (let ((v (shown-of id (get shown))))
      (if (not (null? v))
          (begin (set shown (used! id (get shown))) (mk-symbol (car v) a b))
          (let ((e (listed-elem id)))
            (if (not (null? e))
                (mk-list (list (show-sty (car e) a b) (mk-symbol "..." a b)) a b)
                (let ((name (string-append "m" (int->string (+ (len-shown (get shown)) 1)))))
                  (begin
                    (set shown (cons (tuple id name #f) (get shown)))
                    (let* ((body (show-sty (mu-body id) a b)) (used (extract (car (get shown)) 3)))
                      (begin
                        (set shown (cdr (get shown)))
                        (if (or used (open? (mu-body id)))
                            (mk-list (list (mk-symbol "mu" a b) (mk-symbol name a b) body) a b)
                            body)))))))))))
;; The element of `mu` `id`, in a list of one, if it is a list as `(σ ...)`
;; writes one (`seq-type`): its element as written.
(define listed-elem (->* (int) stys)
  (lambda (id)
    (tagcase (mu-body id)
      (s-union (ms)
        (if (and (not (null? ms)) (not (null? (cdr ms))) (null? (cdr (cdr ms))))
            (listed-of id (car ms) (car (cdr ms)))
            nil))
      (else y nil))))
(define tail-of? (->* (int sty) bool)
  (lambda (id d) (tagcase d (s-mu (j) (= j id)) (else y #f))))
(define listed-of (->* (int sty sty) stys)
  (lambda (id nil-m pair-m)
    (tagcase nil-m
      (s-nil ()
        (tagcase pair-m
          (s-pair (e d)
            (if (and (tail-of? id d)
                     (tagcase e (s-bvar () #f) (s-dvar () #f) (s-export (x bd) #f) (else y #t)))
                (list e)
                nil))
          (else y nil)))
      (s-export (n none)
        (tagcase pair-m
          (s-export (p both)
            (if (and (= (kind-of n) 6) (no-entries? none) (both-ribs? both))
                (tagcase p
                  (s-pair (e d)
                    (if (tail-of? id d)
                        (tagcase e
                          (s-export (x bd)
                            (cond ((and (= (kind-of x) 1) (self-entry? bd 1)) (list x))
                                  ((and (= (kind-of x) 12) (self-entry? bd 4)) (list x))
                                  (else (list e))))
                          (else y nil))
                        nil))
                  (else y nil))
                nil))
          (else y nil)))
      (else y nil))))
(define no-entries? (->* (bind) bool)
  (lambda (bd) (tagcase bd (bind-rib (es) (null? es)) (else y #f))))
(define both-ribs? (->* (bind) bool)
  (lambda (bd)
    (tagcase bd
      (bind-rib (es)
        (and (= (len-entries es) 2)
             (entry-is? (car es) (list #t) 2) (entry-is? (car (cdr es)) (list #f) 2)))
      (else y #f))))
(define self-entry? (->* (bind int) bool)
  (lambda (bd delta)
    (tagcase bd
      (bind-rib (es) (and (= (len-entries es) 1) (entry-is? (car es) nil delta)))
      (else y #f))))
(define len-entries (->* (entries) int)
  (lambda (es) (if (null? es) 0 (+ 1 (len-entries (cdr es))))))
(define entry-is? (->* ((tupleof addr int) addr int) bool)
  (lambda (e a delta) (and (addr-same? (extract e 1) a) (= (extract e 2) delta))))
(define addr-same? (->* (addr addr) bool)
  (lambda (x y)
    (if (null? x)
        (null? y)
        (and (not (null? y)) (eq? (car x) (car y)) (addr-same? (cdr x) (cdr y))))))
(define show-bind (->* (bind int int) syn)
  (lambda (bd a b)
    (tagcase bd
      (bind-rib (es) (show-rib es a b))
      (bind-cage (rs) (mk-list (cons (mk-symbol "cage" a b) (show-rings rs a b)) a b))
      (else y (show-rib nil a b)))))
(define show-rings (->* (rings int int) syns-a)
  (lambda (rs a b)
    (if (null? rs)
        nil
        (cons (tagcase (car rs)
                (ring-rib (es) (show-rib es a b))
                (ring-at (x) (mk-list (list (mk-symbol "at" a b) (show-addr x a b)) a b)))
              (show-rings (cdr rs) a b)))))
(define show-rib (->* (entries int int) syn)
  (lambda (es a b) (mk-list (cons (mk-symbol "rho" a b) (show-entries es a b)) a b)))
(define show-entries (->* (entries int int) syns-a)
  (lambda (es a b)
    (if (null? es)
        nil
        (cons (mk-list (list (show-addr (extract (car es) 1) a b)
                             (mk-symbol (delta-name (extract (car es) 2)) a b))
                       a b)
              (show-entries (cdr es) a b)))))
(define delta-name (->* (int) string)
  (lambda (d)
    (cond ((= d 0) "none") ((= d 1) "var") ((= d 2) "rib") ((= d 3) "env") ((= d 4) "dvar")
          (else "place"))))
(define show-addr (->* (addr int int) syn)
  (lambda (x a b) (if (null? x) (mk-list nil a b) (mk-symbol (addr-letters x "") a b))))
(define addr-letters (->* (addr string) string)
  (lambda (x out)
   (if (null? x) out (addr-letters (cdr x) (string-append (if (car x) "A" "D") out)))))

;; Signature `s` as a message says it (`infer.rs`'s `sig_text`): each
;; annotation, `union`, `mu`, `many` or literal that is a list's rest after
;; a ` . `.
(define sig-text (->* (syn) string)
  (lambda (s)
    (tagcase s
      (lst (items d a b x) (if (null? items) "()" (string-append "(" (sig-items items #t a b) ")")))
      (dotted (items tl d a b x)
        (string-append "(" (sig-items items #f a b) " . " (sig-text tl) ")"))
      (else y (show-syn s)))))
(define sig-word? (->* (syn) bool)
  (lambda (s)
    (and (syn-symbol? s)
         (let ((n (syn-name s)))
           (or (string=? n "import") (string=? n "export") (string=? n "union") (string=? n "mu")
               (string=? n "many") (string=? n "literal"))))))
;; Items `xs`, the first first (`first`); a word of `sig-word?` past the
;; first, and a proper list's, starts its rest.
(define sig-items (->* (syns-a bool int int) string)
  (lambda (xs proper a b) (sig-items-from xs #t proper a b)))
(define sig-items-from (->* (syns-a bool bool int int) string)
  (lambda (xs first proper a b)
    (cond ((null? xs) "")
          ((and (not first) proper (sig-word? (car xs)))
           (string-append " . " (sig-text (mk-list xs a b))))
          (else (string-append (if first "" " ") (sig-text (car xs))
                               (sig-items-from (cdr xs) #f proper a b))))))

;;; ------------------------------------------------------------ inferring

;; The signatures of macros `us`, defined together, inferred: each as
;; written, `(-> σ defn)` and `(-> σ type)` for what makes definitions or a
;; description (`infer.rs`'s `infer`).
(define infer (->* (fails unsigneds) syns-a)
  (lambda (fail us)
    (let* ((rs (rules-of fail us 0)) (makes (makes-all fail us rs)) (saved (get defined))
           (sigs (infer-loop fail us rs makes (sol-empty) nil "" nil 16 saved)))
      (begin
        (set defined saved)
        (made-sigs sigs makes us)))))
(define made-sigs (->* (syns-a ints unsigneds) syns-a)
  (lambda (sigs makes us)
    (if (null? sigs)
        nil
        (let* ((u (car us)) (a (syn-start (extract u 4))) (b (syn-end (extract u 4))))
          (cons (if (= (car makes) 0)
                    (car sigs)
                    (mk-list (list (mk-symbol "->" a b) (car sigs)
                                   (mk-symbol (if (= (car makes) 1) "defn" "type") a b))
                             a b))
                (made-sigs (cdr sigs) (cdr makes) (cdr us)))))))
(define clause-usage string "a clause is `((_ . pattern) template)`")
(define rules-of (->* (fails unsigneds int) rules)
  (lambda (fail us mi)
    (if (null? us)
        nil
        (append (rules-in fail (extract (car us) 3) mi) (rules-of fail (cdr us) (+ mi 1))))))
(define rules-in (->* (fails syns-a int) rules)
  (lambda (fail cs mi)
    (if (null? cs)
        nil
        (let ((two (proper-items (car cs))))
          (if (not (= (len two) 2))
              (begin (fail-at fail clause-usage (car cs)) nil)
              (let ((whole (split (car two))))
                (if (null? whole)
                    (begin (fail-at fail clause-usage (car two)) nil)
                    (cons (tuple mi (nth whole 1) (nth two 1)) (rules-in fail (cdr cs) mi)))))))))
(define-type strings (listof string acyclic))
(define infer-loop
  (->* (fails unsigneds rules ints sol spans string (listof (tupleof strings syns-a) acyclic) int
              macro-env)
       syns-a)
  (lambda (fail us rs makes s0 sticky shape-was last n saved)
    (if (= n 0)
        (if (null? last) nil (extract (car last) 2))
        (begin
          (parts-reset!)
          (let* ((c (tuple (lits-each rs us) (extract s0 2) sticky))
                 (made-roots (begin (set roots (roots-each fail us rs 0 c)) #u))
                 (shape (fingerprint))
                 (s (if (string=? shape shape-was) s0 (fresh-sol (extract s0 2))))
                 (tys (build s))
                 (shown (show-each-sig tys us))
                 (strings (texts shown)))
            (if (and (not (null? last)) (strings=? (extract (car last) 1) strings))
                shown
                (begin
                  (set defined (append (provisional us tys makes) saved))
                  (let* ((ps (placed-each rs makes 0 s))
                         (next (solve ps s makes (rule-macros rs))))
                    (infer-loop fail us rs makes next (append (extract next 7) sticky) shape
                                (list (tuple strings shown)) (- n 1) saved)))))))))
(define fresh-sol (->* (pkinds) sol)
  (lambda (pk)
    (let ((e (sol-empty)))
      (tuple (extract e 1) (typed-pkinds pk) (extract e 3) (extract e 4) (extract e 5)
             (extract e 6) (extract e 7)))))
(define typed-pkinds (->* (pkinds) pkinds)
  (lambda (pk)
    (cond ((null? pk) nil)
          ((tagcase (extract (car pk) 3) (kd-ty (t) #t) (else y #f))
           (cons (car pk) (typed-pkinds (cdr pk))))
          (else (typed-pkinds (cdr pk))))))
(define lits-each (->* (rules unsigneds) (listof names acyclic))
  (lambda (rs us)
    (if (null? rs) nil (cons (extract (nth-u us (extract (car rs) 1)) 2) (lits-each (cdr rs) us)))))
(define nth-u (->* (unsigneds int) unsigned)
  (lambda (us i) (if (= i 0) (car us) (nth-u (cdr us) (- i 1)))))
(define rule-macros (->* (rules) ints)
  (lambda (rs) (if (null? rs) nil (cons (extract (car rs) 1) (rule-macros (cdr rs))))))
(define roots-each (->* (fails unsigneds rules int cx) ints)
  (lambda (fail us rs mi c)
    (if (null? us)
        nil
        (let ((r (merge fail (items-of rs mi 0) nil -1 c)))
          (cons r (roots-each fail (cdr us) rs (+ mi 1) c))))))
(define items-of (->* (rules int int) items)
  (lambda (rs mi cid)
    (cond ((null? rs) nil)
          ((= (extract (car rs) 1) mi)
           (cons (tuple cid (extract (car rs) 2) 0) (items-of (cdr rs) mi (+ cid 1))))
          (else (items-of (cdr rs) mi (+ cid 1))))))
(define show-each-sig (->* (stys unsigneds) syns-a)
  (lambda (tys us)
    (if (null? tys)
        nil
        (let ((u (extract (car us) 4)))
          (begin
            (set shown nil)
            (cons (show-sty (car tys) (syn-start u) (syn-end u))
                  (show-each-sig (cdr tys) (cdr us))))))))
(define texts (->* (syns-a) strings)
  (lambda (xs) (if (null? xs) nil (cons (show-syn (car xs)) (texts (cdr xs))))))
(define strings=? (->* (strings strings) bool)
  (lambda (a b)
    (if (null? a)
        (null? b)
        (and (not (null? b)) (string=? (car a) (car b)) (strings=? (cdr a) (cdr b))))))
(define provisional (->* (unsigneds stys ints) macro-env)
  (lambda (us tys makes)
    (if (null? us)
        nil
        (cons (tuple (extract (car us) 1) (tuple (car tys) nil nil (car makes)))
              (provisional (cdr us) (cdr tys) (cdr makes))))))
(define placed-each (->* (rules ints int sol) by-clause)
  (lambda (rs makes cid s)
    (if (null? rs)
        nil
        (cons (placements-of cid (extract (car rs) 3) (nth-int makes (extract (car rs) 1)) s)
              (placed-each (cdr rs) makes (+ cid 1) s)))))
