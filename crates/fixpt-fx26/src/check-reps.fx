;;; The checker, in FX-26: its types as reps (`docs/research/heap-types.md`,
;;; `TODO.md` §202, step 2): a type's nodes, as the Rust checker's export
;;; makes them (`reps.rs`, whose table of heads this follows), given to the
;;; runtime, which makes the rep canonical (`rep-of-nodes`, `fixpt-reps`).
;;; Both checkers' reps of one type are one rep: the agreement, by reps.
;;; Made by `check-program.fx`, of what it is given (`load-input`).

(let* ((check-types-types (load-module "fx26:check-types-types.fx")))
  (lambda ((check-types (select check-types-types check-types-sig)))
    (module
(hide (include check-types-types))
(hide (include check-types))

;; A node as the runtime takes it (`rep-of-nodes`): its slot, its head, whether
;; it is a set, its binders' names, its operands.
(define-type k-rarg
  (sumof (node int) (bound (productof (1 int) (2 int))) (hole int)
         (const (productof (1 string) (2 int) (3 string))) (sym symbol) (int int) (flag bool)))
(define-type k-rargs (listof k-rarg acyclic))
(define-type k-rnode (productof (1 int) (2 symbol) (3 bool) (4 k-names) (5 k-rargs)))
(define-type k-rnodes (listof k-rnode acyclic))

;; The export's state: the nodes made, newest first; the next slot; each
;; type's slot, once given one; the variables bound where the walk is,
;; innermost first, each with its binder's slot and place; the holes, each
;; variable's number, and their names, newest first.
(define rp-nodes (ref k-rnodes @t) (new nil))
(define rp-next (ref int @t) (new 0))
(define rp-memo (ref (listof (pairof int int @t) acyclic) @t) (new nil))
(define rp-scope (ref (listof (productof (1 int) (2 int) (3 int)) acyclic) @t) (new nil))
(define rp-holes (ref (listof (pairof int int @t) acyclic) @t) (new nil))
(define rp-hole-names (ref k-names @t) (new nil))
(define rp-nholes (ref int @t) (new 0))

(define rp-reserve (->* () int)
  (lambda () (let ((n (get rp-next))) (begin (set rp-next (+ n 1)) n))))
(define rp-fill (->* (int symbol bool k-names k-rargs) unit)
  (lambda (slot head unordered binders args)
    (set rp-nodes (cons (product (1 slot) (2 head) (3 unordered) (4 binders) (5 args))
                        (get rp-nodes)))))
;; A node of no binders, as an operand.
(define rp-node (->* (string k-rargs) k-rarg)
  (lambda (head args)
    (let ((slot (rp-reserve)))
      (begin (rp-fill slot (string->symbol head) #f nil args) (sum node slot)))))
(define rp-set (->* (string k-rargs) k-rarg)
  (lambda (head args)
    (let ((slot (rp-reserve)))
      (begin (rp-fill slot (string->symbol head) #t nil args) (sum node slot)))))
(define rp-sym (->* (string) k-rarg) (lambda (s) (sum sym (string->symbol s))))

(define rp-assoc (->* ((listof (pairof int int @t) acyclic) int) int)
  (lambda (xs k)
    (cond ((null? xs) -1) ((= (car (car xs)) k) (cdr (car xs))) (else (rp-assoc (cdr xs) k)))))
;; Variable `v`: bound, by its binder; else a hole, one for it.
(define rp-var (->* (int) k-rarg)
  (lambda (v)
    (letrec ((find (->* ((listof (productof (1 int) (2 int) (3 int)) acyclic)) k-rarg)
               (lambda (s)
                 (cond ((null? s)
                        (let ((h (rp-assoc (get rp-holes) v)))
                          (if (>= h 0)
                              (sum hole h)
                              (let ((n (get rp-nholes)))
                                (begin (set rp-holes (cons (cons v n) (get rp-holes)))
                                       (set rp-hole-names
                                            (cons (k-dvar-name v) (get rp-hole-names)))
                                       (set rp-nholes (+ n 1))
                                       (sum hole n))))))
                       ((= (extract (car s) 1) v)
                        (sum bound (product (1 (extract (car s) 2)) (2 (extract (car s) 3)))))
                       (else (find (cdr s)))))))
      (find (get rp-scope)))))

(define rp-kind-name (->* (int) string)
  (lambda (k)
    (case k ((0) "region") ((1) "effect") ((3) "place") ((4) "data") ((5) "size") ((6) "conv")
            ((7) "flat") ((8) "sendable") (else "type"))))
(define-rec
  (rp-kind (->* (int) k-rarg)
    (lambda (k)
      (if (k-arrow-kind? k)
          (rp-node "=>" (rp-kinds-then (k-arrow-params k) (k-arrow-result k)))
          (rp-node (rp-kind-name k) nil))))
  (rp-kinds-then (->* (k-ids int) k-rargs)
    (lambda (ks r)
      (if (null? ks) (list (rp-kind r)) (cons (rp-kind (car ks)) (rp-kinds-then (cdr ks) r))))))

(define rp-region (->* (k-region) k-rarg)
  (lambda (r)
    (tagcase r
      (r-var (v) (rp-var v))
      (r-const (s) (rp-node "rconst" (list (sum sym s))))
      (r-fresh (n s) (rp-node "rfresh" (list (sum int n) (rp-sym s))))
      (r-frozen (p f)
        (rp-node "frozen" (if (< p 0) (list (sum flag f)) (list (sum flag f) (rp-var p)))))
      (r-heap () (rp-node "heap" nil))
      (r-global (g) (rp-node "global" (list (sum sym g))))
      (r-globals () (rp-node "globals" nil)))))

(define-rec
  ;; An effect: a set of its atoms (`reps.rs`), in no order of this checker's.
  (rp-effect (->* (k-eff) k-rarg)
    (lambda (e) (rp-set "effect" (rp-atoms e))))
  (rp-atoms (->* (k-eff) k-rargs)
    (lambda (e) (if (null? e) nil (cons (rp-atom (car e)) (rp-atoms (cdr e))))))
  (rp-atom (->* (k-atom) k-rarg)
    (lambda (a)
      (tagcase a
        (a-read (r) (rp-node "read" (list (rp-region r))))
        (a-write (r) (rp-node "write" (list (rp-region r))))
        (a-alloc (r) (rp-node "alloc" (list (rp-region r))))
        (a-goto (r) (rp-node "goto" (list (rp-region r))))
        (a-comefrom (r) (rp-node "comefrom" (list (rp-region r))))
        (a-await (r) (rp-node "await" (list (rp-region r))))
        (a-init (r) (rp-node "init" (list (rp-region r))))
        (a-send (r) (rp-node "send" (list (rp-region r))))
        (a-receive (r) (rp-node "receive" (list (rp-region r))))
        (a-spin () (rp-node "spin" nil))
        (a-io (k) (rp-node "io" (list (rp-sym (k-io-kind-name k)))))
        (a-nondet () (rp-node "nondet" nil))
        (a-stage () (rp-node "stage" nil))
        (a-var (v) (rp-var v))
        (a-app (v ds) (rp-node "eapp" (cons (rp-var v) (rp-eargs ds)))))))
  (rp-eargs (->* (k-descs) k-rargs)
    (lambda (ds) (if (null? ds) nil (cons (rp-earg (car ds)) (rp-eargs (cdr ds))))))
  (rp-earg (->* (k-desc) k-rarg)
    (lambda (d)
      (tagcase d
        (dr (r) (rp-node "e-region" (list (rp-region r))))
        (de (e) (rp-node "e-effect" (list (rp-effect e))))
        (dz (z) (rp-node "e-size" (list (rp-size z))))
        (dc (c) (rp-node "e-conv" (list (rp-conv c))))
        (else y (rp-node "e-type" nil)))))
  (rp-size (->* (k-size) k-rarg)
    (lambda (z)
      (tagcase z
        (sz-finite () (rp-node "finite" nil))
        (sz-lin (k ts) (rp-node "lin" (list (sum int k) (rp-set "terms" (rp-terms ts))))))))
  (rp-terms (->* (k-terms) k-rargs)
    (lambda (ts)
      (if (null? ts)
          nil
          (cons (rp-node "term" (list (rp-var (car (car ts))) (sum int (cdr (car ts)))))
                (rp-terms (cdr ts))))))
  (rp-conv (->* (k-conv) k-rarg)
    (lambda (c)
      (tagcase c
        (cv-cellular () (rp-node "cellular" nil))
        (cv-native () (rp-node "native" nil))
        (cv-fx () (rp-node "fx" nil))
        (cv-var (v) (rp-var v))))))

;; The relation of code `o`, as the Rust checker's `Rel` writes it.
(define rp-rel-name (->* (int) string)
  (lambda (o) (case o ((0) "lt") ((1) "le") ((2) "eq") (else "ne"))))
(define-rec
  (rp-formula (->* (k-sf) k-rarg)
    (lambda (f)
      (tagcase f
        (sf-true () (rp-node "true" nil))
        (sf-false () (rp-node "false" nil))
        (sf-rel (o a b) (rp-node "rel" (list (rp-sym (rp-rel-name o)) (rp-expr a) (rp-expr b))))
        (sf-holds (x) (rp-node "holds" (list (rp-named x))))
        (sf-not (g) (rp-node "not" (list (rp-formula g))))
        (sf-and (gs) (rp-node "and" (rp-formulas gs)))
        (sf-or (gs) (rp-node "or" (rp-formulas gs)))
        (sf-implies (g h) (rp-node "implies" (list (rp-formula g) (rp-formula h)))))))
  (rp-formulas (->* (k-sfs) k-rargs)
    (lambda (gs) (if (null? gs) nil (cons (rp-formula (car gs)) (rp-formulas (cdr gs))))))
  ;; An expression: arithmetic, or a name the Rust checker's `Named` is, as
  ;; `(atom …)`.
  (rp-expr (->* (k-sx) k-rarg)
    (lambda (x)
      (tagcase x
        (sx-lit (k) (rp-node "lit" (list (sum int k))))
        (sx-add (a b) (rp-node "add" (list (rp-expr a) (rp-expr b))))
        (sx-sub (a b) (rp-node "sub" (list (rp-expr a) (rp-expr b))))
        (sx-mul (a b) (rp-node "mul" (list (rp-expr a) (rp-expr b))))
        (else y (rp-node "atom" (list (rp-named x)))))))
  (rp-exprs (->* (k-sxs) k-rargs)
    (lambda (xs) (if (null? xs) nil (cons (rp-expr (car xs)) (rp-exprs (cdr xs))))))
  (rp-named (->* (k-sx) k-rarg)
    (lambda (x)
      (tagcase x
        (sx-param (i) (rp-node "param" (list (sum int i))))
        (sx-result () (rp-node "result" nil))
        (sx-length (i) (rp-node "length" (list (sum int i))))
        (sx-shape (i j) (rp-node "shape" (list (sum int i) (sum int j))))
        (sx-acyclic (i) (rp-node "acyclic" (list (sum int i))))
        (sx-nat (i) (rp-node "nat" (list (sum int i))))
        (sx-length-is (i j) (rp-node "length-is" (list (sum int i) (sum int j))))
        (sx-call (f xs) (rp-node "call" (cons (sum sym f) (rp-exprs xs))))
        (else y (rp-node "atom" (list (rp-expr x))))))))

;; A specification: its names (parameters', then the result's) its binders'.
(define rp-spec (->* (k-spec) k-rarg)
  (lambda (s)
    (let ((slot (rp-reserve)))
      (begin
        (rp-fill slot 'spec #f (append (extract s 1) (list (extract s 2)))
                (list (rp-formula (extract s 3)) (rp-formula (extract s 4))))
        (sum node slot)))))

;; The binders `bs` of node `slot` in scope, from place `pos`; their nodes.
(define rp-bind (->* (k-binders int int) unit)
  (lambda (bs slot pos)
    (if (null? bs)
        #u
        (begin (set rp-scope (cons (product (1 (extract (car bs) 1)) (2 slot) (3 pos))
                                   (get rp-scope)))
               (rp-bind (cdr bs) slot (+ pos 1))))))
(define rp-binder-nodes (->* (k-binders) k-rargs)
  (lambda (bs)
    (if (null? bs)
        nil
        (let* ((v (extract (car bs) 1))
               (bound (k-bound-of v))
               (args (cons (rp-kind (extract (car bs) 2))
                           (cons (sum flag (k-distinct-var? v))
                                 (if (null? bound) nil (list (rp-region (car bound))))))))
          (cons (rp-node "binder" args) (rp-binder-nodes (cdr bs)))))))
(define rp-binder-names (->* (k-binders) k-names)
  (lambda (bs)
    (if (null? bs) nil (cons (k-dvar-name (extract (car bs) 1)) (rp-binder-names (cdr bs))))))
;; A module's abstract types as binders: each variable and its kind.
(define rp-abs-binders (->* (k-parts) k-binders)
  (lambda (ps)
    (if (null? ps)
        nil
        (let* ((v (extract (car ps) 2)) (k (k-dvar-kind v)))
          (cons (product (1 v) (2 (if (< k 0) 2 k))) (rp-abs-binders (cdr ps)))))))
(define rp-labels (->* (k-parts) k-names)
  (lambda (ps) (if (null? ps) nil (cons (extract (car ps) 1) (rp-labels (cdr ps))))))

(define-rec
  ;; Type `t`'s node, as an operand.
  (rp-ty (->* (int) k-rarg)
    (lambda (t0)
      (let* ((t (k-resolve t0)) (had (rp-assoc (get rp-memo) t)))
        (if (>= had 0)
            (sum node had)
            (let ((slot (rp-reserve)))
              (begin (set rp-memo (cons (cons t slot) (get rp-memo)))
                     (rp-ty-at t slot)
                     (sum node slot)))))))
  (rp-tys (->* (k-ids) k-rargs)
    (lambda (ts) (if (null? ts) nil (cons (rp-ty (car ts)) (rp-tys (cdr ts))))))
  (rp-parts (->* (k-parts) k-rargs)
    (lambda (ps)
      (if (null? ps)
          nil
          (cons (sum sym (extract (car ps) 1))
                (cons (rp-ty (extract (car ps) 2)) (rp-parts (cdr ps)))))))
  (rp-desc (->* (k-desc) k-rarg)
    (lambda (d)
      (tagcase d
        (dr (r) (rp-node "d-region" (list (rp-region r))))
        (de (e) (rp-node "d-effect" (list (rp-effect e))))
        (dt (t) (rp-node "d-type" (list (rp-ty t))))
        (dz (z) (rp-node "d-size" (list (rp-size z))))
        (dc (c) (rp-node "d-conv" (list (rp-conv c))))
        (df (f) (rp-node "d-fun" (list (rp-ty f)))))))
  (rp-descs (->* (k-descs) k-rargs)
    (lambda (ds) (if (null? ds) nil (cons (rp-desc (car ds)) (rp-descs (cdr ds))))))
  ;; Node `slot`, type `t`'s, filled.
  (rp-ty-at (->* (int int) unit)
    (lambda (t slot)
      (tagcase (k-get t)
        (ty-base (s) (rp-fill slot 'base #f nil (list (sum sym s))))
        (ty-void () (rp-fill slot 'void #f nil nil))
        (ty-nil () (rp-fill slot 'nil #f nil nil))
        (ty-false () (rp-fill slot 'false #f nil nil))
        (ty-union (ms) (rp-fill slot 'union #f nil (rp-tys ms)))
        (ty-var (v) (rp-fill slot 'var #f nil (list (rp-var v))))
        (ty-subr (e ps r cv spc)
          (rp-fill slot 'subr #f nil
                  (append (list (rp-conv cv) (rp-effect e) (rp-node "params" (rp-tys ps)) (rp-ty r))
                          (if (null? spc) nil (list (rp-spec (car spc)))))))
        (ty-poly (bs body)
          (let* ((saved (get rp-scope)) (u (rp-bind bs slot 0)) (nodes (rp-binder-nodes bs))
                 (b (rp-ty body)))
            (begin (set rp-scope saved)
                   (rp-fill slot 'poly #f (rp-binder-names bs) (append nodes (list b))))))
        (ty-ref (a r) (rp-fill slot 'ref #f nil (list (rp-ty a) (rp-region r))))
        (ty-pair (a b r nl)
          (rp-fill slot 'pairof #f nil (list (rp-ty a) (rp-ty b) (rp-region r) (sum flag nl))))
        (ty-tag (a h e r)
          (rp-fill slot 'prompt-tag #f nil (list (rp-ty a) (rp-ty h) (rp-effect e) (rp-region r))))
        (ty-comp (x a e r once)
          (rp-fill slot 'composable #f nil
                  (list (rp-ty x) (rp-ty a) (rp-effect e) (rp-region r) (sum flag once))))
        (ty-markkey (a r) (rp-fill slot 'mark-key #f nil (list (rp-ty a) (rp-region r))))
        (ty-product (ps) (rp-fill slot 'productof #f nil (rp-parts ps)))
        (ty-sum (ps) (rp-fill slot 'sumof #f nil (rp-parts ps)))
        (ty-array (a z r)
          (rp-fill slot 'narrayof #f nil (list (rp-ty a) (rp-size z) (rp-region r))))
        (ty-icell (a r) (rp-fill slot 'icell #f nil (list (rp-ty a) (rp-region r))))
        (ty-place (r) (rp-fill slot 'place #f nil (list (rp-region r))))
        (ty-nat (z) (rp-fill slot 'nat #f nil (list (rp-size z))))
        (ty-bloblet (fs z r)
          (rp-fill slot 'bloblet #f nil (cons (sum flag z) (cons (rp-region r) (rp-tys fs)))))
        (ty-named (g ds)
          (let* ((gen (k-gen-of g))
                 (n (k-length (extract gen 2)))
                 (kind (if (= n 0) "type" (string-append "generative/" (int->string n))))
                 (c (sum const (product (1 (symbol->string (extract gen 1))) (2 g) (3 kind)))))
            (rp-fill slot 'named #f nil (cons c (rp-descs ds)))))
        (ty-nlist (a z r) (rp-fill slot 'nlist #f nil (list (rp-ty a) (rp-size z) (rp-region r))))
        (ty-module (abs ds vs)
          (let* ((saved (get rp-scope)) (bs (rp-abs-binders abs)) (u (rp-bind bs slot 0))
                 (nodes (rp-binder-nodes bs))
                 (descs (rp-node "descs" (rp-parts ds)))
                 (vals (rp-node "vals" (rp-parts vs))))
            (begin (set rp-scope saved)
                   (rp-fill slot 'moduleof #f (rp-labels abs) (append nodes (list descs vals))))))
        (ty-param (k n) (rp-fill slot 'param-sel #f nil (list (sum int k) (sum sym n))))
        (ty-lam (bs body)
          (let* ((saved (get rp-scope)) (u (rp-bind bs slot 0)) (nodes (rp-binder-nodes bs))
                 (b (rp-desc body)))
            (begin (set rp-scope saved)
                   (rp-fill slot 'dlambda #f (rp-binder-names bs) (append nodes (list b))))))
        (ty-app (g ds) (rp-fill slot 'app #f nil (cons (rp-ty g) (rp-descs ds))))
        (else y (k-fail "a type a rep does not take (an unresolved `select`)" 0 0))))))

;; Type `t` as a rep, in its binary form: its nodes given the runtime, which
;; makes it canonical (`rep-of-nodes`).
(define k-ty-rep (->* (int) (bytevectorof @t))
  (lambda (t)
    (begin
      (set rp-nodes nil) (set rp-next 0) (set rp-memo nil) (set rp-scope nil)
      (set rp-holes nil) (set rp-hole-names nil) (set rp-nholes 0)
      (let ((root (rp-ty t)))
        (tagcase root
          (node slot (rep-of-nodes (get rp-nodes) (reverse (get rp-hole-names)) slot))
          (else y (rep-of-nodes (get rp-nodes) nil 0)))))))
)))
